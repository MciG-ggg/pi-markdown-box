{
  "name": "pi-markdown-box",
  "version": "0.2.0",
  "description": "Pi extension that renders inline Markdown fenced code blocks and tables as terminal boxes (╭─╮ style). Fork of pi-codeblock-box with broader scope.",
  "type": "module",
  "main": "./extensions/index.ts",
  "types": "./extensions/index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "markdown",
    "codeblock",
    "table",
    "tui"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "author": "MciG-ggg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MciG-ggg/pi-markdown-box.git"
  },
  "bugs": {
    "url": "https://github.com/MciG-ggg/pi-markdown-box/issues"
  },
  "homepage": "https://github.com/MciG-ggg/pi-markdown-box#readme"
}